# Postgres connection string (ex.: Supabase > Project Settings > Database > Connection string > Transaction pooler)
DATABASE_URL=postgres://user:password@host:6543/postgres

# Senha única de acesso ao app (mínimo 12 caracteres)
APP_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# Fuso horário usado para definir "o treino de hoje"
APP_TIMEZONE=America/Belem

# League of Legends: Riot ID acompanhado, servidor e chave da API (developer.riotgames.com).
# Sem RIOT_API_KEY a página mostra as partidas já salvas, mas não sincroniza novas.
# Use aspas: em arquivos .env, o "#" sem aspas começa um comentário.
RIOT_ID="duDuBoxBox#2713"
RIOT_PLATFORM=br1
RIOT_API_KEY=

# CS2 / FACEIT: nickname (diferencia maiúsculas) e chave "Server side" de developers.faceit.com.
FACEIT_NICKNAME=_pHeniX
FACEIT_API_KEY=

# CS2 Premier/matchmaking via Leetify (ao vivo, nada é salvo). Steam64 ID de 17 dígitos.
# A chave é opcional (leetify.com/app/developer); sem ela o limite de requisições é menor.
LEETIFY_STEAM64_ID=76561198149032763
LEETIFY_API_KEY=
